<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="/styles/index.css" rel="stylesheet" >
    <title><%= title %></title>
</head>
<body>
    <div id="board-container">
        <a href="/new">New Message</a>
        <% [...messages].reverse().forEach((msg, i) => { %>
            <div class="message-container">
                <h2><%= msg.author %></h2>
                <p><%= msg.message %></p>
                <p class="secondary-text"><%= msg.create_at.toLocaleString() %></p>
                <a href=<%= msg.id %>>OPEN</a>
            </div>
        <% }); %>
    </div>
</body>
</html>